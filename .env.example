# Bind address for `yt-transcript serve`
HOST=127.0.0.1
PORT=8000
# If non-empty, every /api/v2 request must send `Authorization: Bearer <API_KEY>`
API_KEY=
# Comma-separated proxy URLs (http://user:pass@host:port, socks5://host:port); empty = direct
YT_PROXIES=
# Netscape cookies.txt, used by the yt-dlp fallback only
YT_COOKIES_FILE=
# Ordered InnerTube player clients (ANDROID, IOS, ANDROID_VR, WEB)
YT_PLAYER_CLIENTS=ANDROID,IOS,ANDROID_VR
# Max simultaneous upstream requests
YT_MAX_CONCURRENCY=4
# Minimum spacing between upstream request starts (ms)
YT_MIN_INTERVAL_MS=300
# Bench time (s) for a (client, proxy) pair after a bot check / 429 / reload
YT_CLIENT_COOLDOWN_S=600
# Upstream HTTP timeout (s)
YT_REQUEST_TIMEOUT_S=15.0
# Fall back to yt-dlp when all InnerTube clients are blocked
YTDLP_FALLBACK=true
CACHE_ENABLED=true
# SQLite cache file; default: $XDG_CACHE_HOME/yt-transcript/cache.sqlite3 (~/.cache/yt-transcript/...)
# CACHE_PATH=/path/to/cache.sqlite3
LOG_LEVEL=INFO
